<%
const data = {
    title: 'Contact Us - Get in Touch with AmaniCare Center',
    activePage: 'contact',
    styles: '<link rel="stylesheet" href="/css/contact.css">',
    scripts: '<script src="/js/contact.js"></script>',
    content: `
        <!-- Contact Hero -->
        <section class="contact-hero">
            <div class="container">
                <div class="contact-hero__content">
                    <h1>Contact Us</h1>
                    <p>Get in touch with our healthcare team. We're here to answer your questions and provide the medical care you need.</p>
                </div>
            </div>
        </section>

        <!-- Contact Methods -->
        <section class="contact-methods">
            <div class="container">
                <h2 class="section__title">How Can We Help You?</h2>
                <p class="section__subtitle">Multiple ways to reach our healthcare professionals for appointments, inquiries, and emergency situations</p>
                
                <div class="methods-grid">
                    <div class="method-card">
                        <div class="method-icon">📞</div>
                        <h3>Phone Consultation</h3>
                        <p>Speak directly with our medical staff for quick advice and appointment scheduling</p>
                        <div class="method-contact">
                            <strong>General Inquiries</strong>
                            <span>+255 123 456 789</span>
                        </div>
                        <div class="method-contact">
                            <strong>Emergency Line</strong>
                            <span>+255 987 654 321</span>
                        </div>
                        <a href="tel:+255123456789" class="btn btn--primary">Call Now</a>
                    </div>

                    <div class="method-card">
                        <div class="method-icon">✉️</div>
                        <h3>Email Support</h3>
                        <p>Send us detailed inquiries and we'll respond with comprehensive information</p>
                        <div class="method-contact">
                            <strong>General Information</strong>
                            <span>info@amanicare.co.tz</span>
                        </div>
                        <div class="method-contact">
                            <strong>Medical Questions</strong>
                            <span>medical@amanicare.co.tz</span>
                        </div>
                        <a href="mailto:info@amanicare.co.tz" class="btn btn--primary">Send Email</a>
                    </div>

                    <div class="method-card">
                        <div class="method-icon">💬</div>
                        <h3>Live Chat</h3>
                        <p>Instant messaging with our support team during business hours for quick answers</p>
                        <div class="method-contact">
                            <strong>Available</strong>
                            <span>Mon-Fri: 8AM-6PM</span>
                        </div>
                        <div class="method-contact">
                            <strong>Response Time</strong>
                            <span>Within 5 minutes</span>
                        </div>
                        <button class="btn btn--primary" onclick="contact.startLiveChat()">Start Chat</button>
                    </div>

                    <div class="method-card">
                        <div class="method-icon">🏥</div>
                        <h3>Visit Our Center</h3>
                        <p>Come see us in person for face-to-face consultations and immediate care</p>
                        <div class="method-contact">
                            <strong>Address</strong>
                            <span>123 Healthcare Street, Dar es Salaam, Tanzania</span>
                        </div>
                        <div class="method-contact">
                            <strong>Walk-in Hours</strong>
                            <span>Mon-Sat: 8AM-6PM</span>
                        </div>
                        <button class="btn btn--primary" onclick="contact.showDirections()">Get Directions</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Form Section -->
        <section class="contact-form-section">
            <div class="container">
                <div class="contact-container">
                    <div class="contact-form">
                        <h2>Send Us a Message</h2>
                        <p>Fill out the form below and our team will get back to you as soon as possible</p>
                        
                        <form id="contactForm">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contactName" class="form-label">Full Name *</label>
                                    <input type="text" id="contactName" name="name" class="form-control" placeholder="Enter your full name" required>
                                </div>
                                <div class="form-group">
                                    <label for="contactEmail" class="form-label">Email Address *</label>
                                    <input type="email" id="contactEmail" name="email" class="form-control" placeholder="your.email@example.com" required>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contactPhone" class="form-label">Phone Number</label>
                                    <input type="tel" id="contactPhone" name="phone" class="form-control" placeholder="+255 XXX XXX XXX">
                                </div>
                                <div class="form-group">
                                    <label for="contactService" class="form-label">Service Interested In</label>
                                    <select id="contactService" name="service_choice" class="form-control">
                                        <option value="">Select a service</option>
                                        <option value="pharmacy">Pharmacy & Medicines</option>
                                        <option value="consultation">Medical Consultation</option>
                                        <option value="clinic">Clinic Services</option>
                                        <option value="emergency">Emergency Care</option>
                                        <option value="general">General Inquiry</option>
                                        <option value="billing">Billing & Insurance</option>
                                        <option value="feedback">Feedback & Complaints</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="contactSubject" class="form-label">Subject *</label>
                                <input type="text" id="contactSubject" name="subject" class="form-control" placeholder="Brief description of your inquiry" required>
                            </div>

                            <div class="form-group">
                                <label for="contactMessage" class="form-label">Message *</label>
                                <textarea id="contactMessage" name="message" class="form-textarea" rows="6" placeholder="Please provide detailed information about your inquiry, questions, or concerns..." required></textarea>
                            </div>

                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" name="newsletter" checked>
                                    <span class="checkmark"></span>
                                    Send me updates about healthcare tips and AmaniCare services
                                </label>
                            </div>

                            <button type="submit" class="btn btn--primary btn--full">
                                Send Message
                            </button>
                        </form>
                    </div>

                    <div class="contact-info">
                        <h3>Contact Information</h3>
                        
                        <div class="info-section">
                            <h4>📍 Location</h4>
                            <div class="info-item">
                                <div class="info-icon">🏢</div>
                                <div class="info-text">
                                    <strong>AmaniCare Center</strong>
                                    <span>123 Healthcare Street</span>
                                    <span>Dar es Salaam, Tanzania</span>
                                </div>
                            </div>
                        </div>

                        <div class="info-section">
                            <h4>📞 Phone Numbers</h4>
                            <div class="info-item">
                                <div class="info-icon">📱</div>
                                <div class="info-text">
                                    <strong>General Inquiries</strong>
                                    <span>+255 123 456 789</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-icon">🚑</div>
                                <div class="info-text">
                                    <strong>Emergency Line</strong>
                                    <span>+255 987 654 321</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-icon">💊</div>
                                <div class="info-text">
                                    <strong>Pharmacy</strong>
                                    <span>+255 123 456 790</span>
                                </div>
                            </div>
                        </div>

                        <div class="info-section">
                            <h4>🕒 Operating Hours</h4>
                            <div class="info-item">
                                <div class="info-icon">📅</div>
                                <div class="info-text">
                                    <strong>Clinic Hours</strong>
                                    <span>Monday - Friday: 8:00 AM - 6:00 PM</span>
                                    <span>Saturday: 9:00 AM - 2:00 PM</span>
                                    <span>Sunday: Emergency Only</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-icon">⏰</div>
                                <div class="info-text">
                                    <strong>Pharmacy Hours</strong>
                                    <span>Monday - Saturday: 8:00 AM - 8:00 PM</span>
                                    <span>Sunday: 9:00 AM - 4:00 PM</span>
                                </div>
                            </div>
                        </div>

                        <div class="info-section">
                            <h4>📧 Email Addresses</h4>
                            <div class="info-item">
                                <div class="info-icon">✉️</div>
                                <div class="info-text">
                                    <strong>General Information</strong>
                                    <span>info@amanicare.co.tz</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-icon">👨‍⚕️</div>
                                <div class="info-text">
                                    <strong>Medical Team</strong>
                                    <span>medical@amanicare.co.tz</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-icon">💊</div>
                                <div class="info-text">
                                    <strong>Pharmacy</strong>
                                    <span>pharmacy@amanicare.co.tz</span>
                                </div>
                            </div>
                        </div>

                        <div class="emergency-notice">
                            <div class="emergency-icon">🚨</div>
                            <div class="emergency-content">
                                <h4>Emergency Medical Care</h4>
                                <p>For life-threatening emergencies, please call our emergency line immediately or visit our center without delay. Our emergency department operates 24/7.</p>
                                <a href="tel:+255987654321" class="btn btn--secondary">Call Emergency Line</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <div class="container">
                <h2 class="section__title">Frequently Asked Questions</h2>
                <p class="section__subtitle">Quick answers to common questions about our services and procedures</p>
                
                <div class="faq-grid">
                    <div class="faq-item">
                        <h4>How do I book an appointment?</h4>
                        <p>You can book appointments through our website, by phone, or by visiting our center. Online booking is available 24/7 for your convenience.</p>
                    </div>
                    <div class="faq-item">
                        <h4>What should I bring to my first visit?</h4>
                        <p>Please bring your ID, insurance card (if applicable), any current medications, and relevant medical records or test results.</p>
                    </div>
                    <div class="faq-item">
                        <h4>Do you accept insurance?</h4>
                        <p>Yes, we work with most major insurance providers. Please contact our billing department for specific information about your insurance coverage.</p>
                    </div>
                    <div class="faq-item">
                        <h4>What are your emergency services?</h4>
                        <p>We provide 24/7 emergency care for urgent medical conditions. Our emergency department is fully equipped and staffed by experienced medical professionals.</p>
                    </div>
                    <div class="faq-item">
                        <h4>Can I get prescription refills?</h4>
                        <p>Yes, prescription refills can be requested through our pharmacy. Some medications may require a follow-up consultation with your doctor.</p>
                    </div>
                    <div class="faq-item">
                        <h4>Do you offer telemedicine services?</h4>
                        <p>Yes, we offer virtual consultations for follow-up visits and non-emergency medical concerns. Contact us to schedule a telemedicine appointment.</p>
                    </div>
                </div>
            </div>
        </section>
    `
};
%>

<%- include('base', data) %>