<%
const data = {
    title: 'Pharmacy - Quality Medicines & Healthcare Products',
    activePage: 'pharmacy',
    styles: `
        <link rel="stylesheet" href="/css/pharmacy.css">
        <link rel="stylesheet" href="/css/cart.css">
    `,
    scripts: `
        <script src="/js/pharmacy.js"></script>
        <script src="/js/cart.js"></script>
    `,
    content: `
        <!-- Pharmacy Hero Section -->
        <section class="pharmacy-hero">
            <div class="container">
                <div class="pharmacy-hero__content">
                    <h1>Pharmacy & Medicines</h1>
                    <p>Quality healthcare products and prescription medicines at competitive prices with expert pharmacist guidance</p>
                    <div class="search-box">
                        <input type="text" id="drugSearch" placeholder="Search medicines by name, generic name, or manufacturer...">
                        <button class="btn btn--primary">Search Medicines</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cart Floating Button -->
        <div class="cart-floating" id="cartFloating" onclick="cart.showCart()">
            <div class="cart-icon">💊</div>
            <span class="cart-count" id="cartCount">0</span>
        </div>

        <!-- Categories Section -->
        <section class="categories">
            <div class="container">
                <h2 class="section__title">Medicine Categories</h2>
                <p class="section__subtitle">Browse our comprehensive range of healthcare products organized by category</p>
                
                <div class="categories-grid" id="categoriesGrid">
                    <!-- Categories will be loaded here -->
                </div>
            </div>
        </section>

        <!-- Medicines Section -->
        <section class="medicines">
            <div class="container">
                <div class="medicines-header">
                    <h2>Available Medicines</h2>
                    <div class="filter-controls">
                        <select id="categoryFilter">
                            <option value="">All Categories</option>
                        </select>
                        <select id="sortFilter">
                            <option value="name">Sort by Name</option>
                            <option value="price">Sort by Price: Low to High</option>
                        </select>
                    </div>
                </div>
                
                <div class="medicines-grid" id="medicinesGrid">
                    <!-- Medicines will be loaded here -->
                </div>

                <div class="loading-spinner" id="loadingSpinner">
                    <div class="spinner"></div>
                    <p>Loading medicines...</p>
                </div>

                <div class="no-results" id="noResults" style="display: none;">
                    <h3>No medicines found</h3>
                    <p>Try adjusting your search or filter criteria to find what you're looking for.</p>
                </div>
            </div>
        </section>

        <!-- Medicine Modal -->
        <div class="modal" id="medicineModal">
            <div class="modal-content">
                <span class="close-modal">&times;</span>
                <div id="modalContent">
                    <!-- Medicine details will be loaded here -->
                </div>
            </div>
        </div>

        <!-- Cart Sidebar -->
        <div class="cart-sidebar" id="cartSidebar">
            <div class="cart-header">
                <h3>Your Shopping Cart</h3>
                <button class="close-cart" onclick="cart.hideCart()">&times;</button>
            </div>
            <div class="cart-items" id="cartItems">
                <!-- Cart items will be loaded here -->
            </div>
            <div class="cart-empty" id="cartEmpty">
                <div class="empty-icon">💊</div>
                <h4>Your cart is empty</h4>
                <p>Add medicines to get started</p>
            </div>
            <div class="cart-summary" id="cartSummary">
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="cartSubtotal">$0.00</span>
                </div>
                <div class="summary-row">
                    <span>Delivery Fee</span>
                    <span id="cartDelivery">$0.00</span>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <span id="cartTotal">$0.00</span>
                </div>
                <button class="btn btn--primary btn--full" onclick="cart.checkout()">Proceed to Checkout</button>
            </div>
        </div>

        <!-- Checkout Modal -->
        <div class="modal" id="checkoutModal">
            <div class="modal-content checkout-modal">
                <span class="close-modal" onclick="cart.closeCheckout()">&times;</span>
                <h2>Checkout</h2>
                
                <div class="checkout-container">
                    <div class="checkout-left">
                        <form id="checkoutForm">
                            <div class="form-section">
                                <h4>Delivery Information</h4>
                                <div class="form-group">
                                    <label for="patientName" class="form-label form-label--required">Full Name</label>
                                    <input type="text" id="patientName" name="patientName" class="form-control" required>
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="phone" class="form-label form-label--required">Phone Number</label>
                                        <input type="tel" id="phone" name="phone" class="form-control" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="email" class="form-label">Email Address</label>
                                        <input type="email" id="email" name="email" class="form-control">
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="deliveryAddress" class="form-label form-label--required">Delivery Address</label>
                                    <textarea id="deliveryAddress" name="deliveryAddress" class="form-textarea" rows="3" required></textarea>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h4>Delivery Options</h4>
                                <div class="delivery-options">
                                    <label class="delivery-option">
                                        <input type="radio" name="deliveryOption" value="pickup" checked>
                                        <div class="option-content">
                                            <div class="option-icon">🏥</div>
                                            <div>
                                                <strong>Pickup at Pharmacy</strong>
                                                <small>Free - Available today</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="delivery-option">
                                        <input type="radio" name="deliveryOption" value="delivery">
                                        <div class="option-content">
                                            <div class="option-icon">🚚</div>
                                            <div>
                                                <strong>Home Delivery</strong>
                                                <small>$5.00 - 2-3 business days</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h4>Payment Method</h4>
                                <div class="payment-options">
                                    <label class="payment-option">
                                        <input type="radio" name="paymentMethod" value="cash" checked>
                                        <div class="option-content">
                                            <div class="option-icon">💰</div>
                                            <div>
                                                <strong>Cash on Delivery</strong>
                                                <small>Pay when you receive</small>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="payment-option">
                                        <input type="radio" name="paymentMethod" value="card">
                                        <div class="option-content">
                                            <div class="option-icon">💳</div>
                                            <div>
                                                <strong>Credit/Debit Card</strong>
                                                <small>Pay securely online</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" name="terms" required>
                                    <span class="checkmark"></span>
                                    I agree to the <a href="/terms" target="_blank">Terms & Conditions</a> and <a href="/privacy" target="_blank">Privacy Policy</a>
                                </label>
                            </div>
                            
                            <button type="submit" class="btn btn--primary btn--full">Place Order</button>
                        </form>
                    </div>
                    
                    <div class="checkout-right">
                        <h4>Order Summary</h4>
                        <div class="order-items" id="checkoutItems">
                            <!-- Order items will be loaded here -->
                        </div>
                        <div class="order-summary">
                            <div class="summary-row">
                                <span>Subtotal</span>
                                <span id="checkoutSubtotal">$0.00</span>
                            </div>
                            <div class="summary-row">
                                <span>Delivery</span>
                                <span id="checkoutDelivery">$0.00</span>
                            </div>
                            <div class="summary-row total">
                                <span>Total</span>
                                <span id="checkoutTotal">$0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Confirmation Modal -->
        <div class="modal" id="orderConfirmation">
            <div class="modal-content confirmation-modal">
                <div class="confirmation-icon">✅</div>
                <h2>Order Confirmed!</h2>
                <p>Your order has been placed successfully.</p>
                <div class="order-details">
                    <div class="order-detail">
                        <strong>Order ID:</strong>
                        <span id="confirmedOrderId">ORD-123456</span>
                    </div>
                    <div class="order-detail">
                        <strong>Total Amount:</strong>
                        <span id="confirmedOrderTotal">$0.00</span>
                    </div>
                    <div class="order-detail">
                        <strong>Status:</strong>
                        <span class="status-pending">Pending</span>
                    </div>
                </div>
                <div class="confirmation-actions">
                    <button class="btn btn--primary" onclick="cart.closeConfirmation()">Continue Shopping</button>
                    <button class="btn btn--outline" onclick="cart.viewOrder()">View Order Details</button>
                </div>
            </div>
        </div>
    `
};
%>

<%- include('base', data) %>